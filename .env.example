# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# MySQL Database Configuration
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
MYSQL_USER=odoo_user
MYSQL_PASSWORD=odoo_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=subscription_management_db

# Optional direct database URL override
# DATABASE_URL=mysql+pymysql://odoo_user:odoo_password@localhost:3306/subscription_management_db

# Email / SMTP Configuration (for password reset)
# If MAIL_SERVER is left blank, password reset links will log safely to server logs
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@subscription-odoo.com

# Admin Seed Configuration (Initial admin setup)
INITIAL_ADMIN_EMAIL=admin@odoo.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@Odoo2026!
